{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#charles-sturt-university-diploma","title":"\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\uff08Charles Sturt University Diploma\uff09\u6837\u5f0f\u89e3\u6790\u4e0e\u5b98\u65b9\u5b66\u672f\u6210\u679c\u9a8c\u8bc1\u6307\u5357","text":"<p>\u5728\u8de8\u56fd\u4eba\u624d\u6d41\u52a8\u3001\u6d77\u5f52\u843d\u6237\u7533\u62a5\u4ee5\u53ca\u5404\u5927\u4f01\u4e8b\u4e1a\u5355\u4f4d\u7684\u5165\u804c\u80cc\u666f\u8c03\u67e5\u4e2d\uff0c\u6d77\u5916\u9ad8\u7b49\u6559\u80b2\u5b66\u5386\u7684\u771f\u5b9e\u6027\u59cb\u7ec8\u662f\u6838\u5fc3\u5ba1\u67e5\u73af\u8282\u3002\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u4e00\u6240\u4eab\u8a89\u56fd\u9645\u7684\u516c\u7acb\u7efc\u5408\u6027\u5927\u5b66\uff0c\u67e5\u5c14\u65af\u7279\u5927\u5b66\uff08Charles Sturt University\uff0c\u7b80\u79f0 CSU\uff09\u6838\u53d1\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Diploma / Certificate of Degree\uff09\u4e0d\u4ec5\u662f\u6bd5\u4e1a\u751f\u5b66\u672f\u6210\u679c\u7684\u6cd5\u5b9a\u51ed\u8bc1\uff0c\u66f4\u662f\u5176\u9ad8\u6c34\u5e73\u4e13\u4e1a\u80fd\u529b\u7684\u76f4\u63a5\u4f53\u73b0\u3002</p> <p></p> <p>\u7136\u800c\uff0c\u8fd1\u5e74\u6765\u5168\u7403\u6559\u80b2\u5e02\u573a\u4e2d\u5076\u6709\u5047\u5192\u6587\u51ed\u6d41\u51fa\uff0c\u5bfc\u81f4\u90e8\u5206\u4eba\u529b\u8d44\u6e90\u90e8\u95e8\uff08HR\uff09\u53ca\u7559\u5b66\u670d\u52a1\u673a\u6784\u5728\u9762\u5bf9\u76f8\u5173\u8bc1\u4e66\u65f6\uff0c\u6025\u9700\u4e00\u5957\u6743\u5a01\u3001\u7cfb\u7edf\u7684\u6bd4\u5bf9\u548c\u6838\u9a8c\u65b9\u6848\u3002\u672c\u6587\u5c06\u57fa\u4e8e2026\u5e74\u6700\u65b0\u5b98\u65b9\u89c4\u8303\uff0c\u6df1\u5ea6\u62c6\u89e3\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u7684\u5fae\u89c2\u9632\u4f2a\u7279\u5f81\uff0c\u5e76\u5168\u9762\u516c\u5f00\u5b98\u65b9\u8ba4\u53ef\u7684\u6570\u5b57\u5316\u4e0e\u8de8\u56fd\u5b66\u672f\u6210\u679c\u9a8c\u8bc1\u6e20\u9053\uff0c\u5e2e\u52a9\u96c7\u4e3b\u4e0e\u6c42\u804c\u8005\u5b9e\u73b0\u9ad8\u6548\u3001\u5408\u89c4\u7684\u5b66\u5386\u6838\u9a8c\u3002</p>"},{"location":"#_1","title":"\u4e8c\u3001 \u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u5b98\u65b9\u6807\u51c6\u6837\u5f0f\u4e0e\u9632\u4f2a\u7279\u5f81\u89e3\u6790","text":"<p>\u4e3a\u4e86\u5728\u7b2c\u4e00\u9636\u6bb5\u901a\u8fc7\u89c6\u89c9\u6bd4\u5bf9\u6392\u9664\u7edd\u5927\u90e8\u5206\u7c97\u7cd9\u7684\u4f2a\u9020\u8bc1\u4e66\uff0c\u4e86\u89e3\u67e5\u5c14\u65af\u7279\u5927\u5b66\uff08CSU\uff09\u5b98\u65b9\u6587\u51ed\u7684\u6392\u7248\u5e03\u5c40\u4e0e\u7279\u6b8a\u5370\u5237\u5de5\u827a\u81f3\u5173\u91cd\u8981\u3002</p>"},{"location":"#1","title":"1. \u8bc1\u4e66\u6392\u7248\u5e03\u5c40\u4e0e\u6838\u5fc3\u89c6\u89c9\u8981\u7d20","text":"<p>\u6807\u51c6\u7684\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u91c7\u7528\u7684\u662f\u6a2a\u5411\uff08Landscape\uff09\u6216\u7eb5\u5411\uff08Portrait\uff09\u56fd\u9645\u6807\u51c6A4\u6216\u7565\u5927\u4e8eA4\u7684\u7279\u5236\u7eb8\u5f20\u3002\u6574\u4f53\u89c6\u89c9\u98ce\u683c\u65e2\u4fdd\u7559\u4e86\u82f1\u8054\u90a6\u9ad8\u7b49\u6559\u80b2\u7684\u4e25\u8c28\u6027\uff0c\u53c8\u878d\u5165\u4e86\u73b0\u4ee3\u9632\u4f2a\u7f8e\u5b66\u3002</p> <ul> <li>\u5b98\u65b9\u6821\u5fbd\uff08The University Seal / Crest\uff09\uff1a \u8bc1\u4e66\u4e0a\u65b9\u6216\u7279\u5b9a\u663e\u8457\u4f4d\u7f6e\u5370\u6709\u67e5\u5c14\u65af\u7279\u5927\u5b66\u7684\u6cd5\u5b9a\u6821\u5fbd\u3002\u6807\u51c6\u6821\u5fbd\u8272\u5f69\u9971\u6ee1\uff0c\u8fb9\u7f18\u5fae\u7f29\u7ebf\u6761\u6e05\u6670\uff0c\u4e0d\u5e94\u51fa\u73b0\u56fe\u6848\u6a21\u7cca\u3001\u8fb9\u7f18\u6bdb\u7cd9\u6216\u8272\u5f69\u9519\u4f4d\u7b49\u4f4e\u7aef\u5370\u5237\u95ee\u9898\u3002</li> <li>\u6838\u5fc3\u6587\u672c\u4fe1\u606f\uff08Core Credentials\uff09\uff1a \u6b63\u6587\u7edf\u4e00\u91c7\u7528\u5927\u5b66\u6cd5\u5b9a\u7684\u5b98\u65b9\u5b57\u4f53\uff0c\u4f9d\u6b21\u5305\u542b\uff1a</li> <li>\u83b7\u5f97\u8005\u7684\u6cd5\u5b9a\u82f1\u6587\u5168\u540d\uff08\u9700\u4e0e\u62a4\u7167\u4e00\u81f4\uff09\u3002</li> <li>\u6388\u4e88\u7684\u5177\u4f53\u5b66\u4f4d\u540d\u79f0\uff08\u4f8b\u5982\uff1aBachelor of Business\u3001Master of Information Technology\uff09\u3002</li> <li>\u6bd5\u4e1a\u751f\u6240\u83b7\u5f97\u7684\u8363\u8a89\u7b49\u7ea7\uff08\u5982\u9002\u7528\uff0c\u5982 First Class Honours\uff09\u3002</li> <li>\u8bc1\u4e66\u6838\u53d1\u7684\u6cd5\u5b9a\u65e5\u671f\uff08Conferral Date\uff09\u3002</li> <li>\u552f\u4e00\u8bc1\u4e66\u7f16\u53f7\uff08Unique Testamur Number\uff09\uff1a \u6bcf\u4e00\u4efd\u6b63\u5f0f\u7684\u7eb8\u8d28\u5b66\u4f4d\u8bc1\u4e66\u5e95\u90e8\u90fd\u5305\u542b\u4e00\u7ec4\u5168\u56fd\u4e43\u81f3\u5168\u7403\u552f\u4e00\u7684\u8bc1\u4e66\u5e8f\u5217\u53f7\u3002\u8be5\u7f16\u53f7\u4e0e\u6821\u65b9\u5185\u7f51\u6570\u636e\u5e93\u53ca\u6fb3\u5927\u5229\u4e9a\u56fd\u5bb6\u9ad8\u7b49\u6559\u80b2\u6863\u6848\u7cfb\u7edf\u5b9e\u65f6\u6302\u94a9\u3002</li> </ul>"},{"location":"#2","title":"2. \u9ad8\u9636\u5370\u5237\u9632\u4f2a\u5de5\u827a","text":"<p>\u4f5c\u4e3a\u4e00\u6240\u91cd\u89c6\u4fe1\u606f\u5316\u5efa\u8bbe\u7684\u6fb3\u6d32\u540d\u6821\uff0c\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5728\u7eb8\u8d28\u8bc1\u4e66\u7684\u5370\u5236\u4e0a\u91c7\u7528\u4e86\u591a\u9879\u7269\u7406\u9632\u4f2a\u6280\u672f\uff1a</p> <ul> <li>\u7279\u5236\u5b89\u5168\u9632\u4f2a\u7eb8\u5f20\uff1a \u5b98\u65b9\u8bc1\u4e66\u7edd\u975e\u666e\u901a\u7684\u94dc\u7248\u7eb8\u6216A4\u6253\u5370\u7eb8\uff0c\u800c\u662f\u91c7\u7528\u542b\u6709\u7279\u5b9a\u514b\u91cd\u3001\u5e26\u6709\u72ec\u7279\u89e6\u611f\u53ca\u9690\u542b\u6c34\u5370\uff08Watermark\uff09\u7684\u5b89\u5168\u4e13\u7528\u7eb8\u3002\u5728\u7279\u5b9a\u6ce2\u957f\u7684\u7d2b\u5916\u5149\uff08UV\uff09\u7167\u5c04\u4e0b\uff0c\u90e8\u5206\u533a\u57df\u4f1a\u663e\u73b0\u51fa\u9690\u85cf\u7684\u9632\u4f2a\u8367\u5149\u6807\u8bb0\u3002</li> <li>\u5fae\u7f29\u6587\u5b57\u4e0e\u9632\u590d\u5370\u5e95\u7eb9\uff1a \u8bc1\u4e66\u7684\u8fb9\u6846\u6216\u7279\u5b9a\u7ebf\u6761\u5b9e\u5219\u662f\u7531\u9ad8\u7cbe\u5ea6\u7684\u5fae\u7f29\u82f1\u6587\u5b57\u6bcd\uff08Microtext\uff09\u62fc\u63a5\u800c\u6210\uff0c\u5728\u653e\u5927\u955c\u4e0b\u6e05\u6670\u53ef\u8fa8\u3002\u82e5\u4f7f\u7528\u666e\u901a\u9ad8\u6e05\u590d\u5370\u673a\u8fdb\u884c\u590d\u5236\uff0c\u8fd9\u4e9b\u5fae\u7f29\u6587\u5b57\u4f1a\u4e25\u91cd\u5316\u5f00\uff0c\u4e14\u5e95\u7eb9\u4e0a\u4f1a\u81ea\u52a8\u6d6e\u73b0\u201cCOPY\u201d\u6216\u201cVOID\u201d\u7b49\u8b66\u544a\u5b57\u6837\u3002</li> <li>\u91d1\u5c5e\u9632\u4f2a\u7b94\u5370\uff08Foil Stamping\uff09\uff1a \u6821\u5fbd\u6216\u7279\u5b9a\u94a2\u5370\u90e8\u5206\u901a\u5e38\u91c7\u7528\u9ad8\u7cbe\u5ea6\u7684\u70eb\u91d1\u3001\u70eb\u94f6\u6216\u538b\u51f9\u51f8\u5de5\u827a\uff0c\u91d1\u5c5e\u5149\u6cfd\u5728\u4e0d\u540c\u89d2\u5ea6\u4e0b\u6298\u5c04\u7387\u5747\u5300\uff0c\u4e14\u7528\u624b\u89e6\u6478\u6709\u660e\u663e\u7684\u51f9\u51f8\u8d28\u611f\u3002</li> </ul>"},{"location":"#myequals","title":"\u4e09\u3001 MyeQuals\u7cfb\u7edf\uff1a\u6570\u5b57\u65f6\u4ee3\u4e0b\u7684\u5b98\u65b9\u5b66\u672f\u6210\u679c\u9a8c\u8bc1\u6e20\u9053","text":"<p>\u968f\u7740\u5168\u7403\u6559\u80b2\u6570\u5b57\u5316\u7684\u666e\u53ca\uff0c\u7eb8\u8d28\u8bc1\u4e66\u5728\u65e5\u5e38\u80cc\u8c03\u4e2d\u7684\u6743\u91cd\u6b63\u9010\u6b65\u8ba9\u4f4d\u4e8e\u6570\u5b57\u5316\u9a8c\u8bc1\u3002\u76ee\u524d\uff0c\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5df2\u5168\u9762\u63a5\u5165\u5927\u6d0b\u6d32\u6700\u6743\u5a01\u7684\u6570\u5b57\u6559\u80b2\u51ed\u8bc1\u5e73\u53f0\u2014\u2014MyeQuals\u3002</p>"},{"location":"#1-myequals","title":"1. \u4ec0\u4e48\u662f MyeQuals \u6570\u5b57\u8bc1\u4e66\u94fe\uff1f","text":"<p>MyeQuals \u662f\u7531\u6fb3\u5927\u5229\u4e9a\u548c\u65b0\u897f\u5170\u6240\u6709\u4e3b\u6d41\u5927\u5b66\u8054\u5408\u63a8\u51fa\u7684\u5b98\u65b9\u6570\u5b57\u5b66\u4f4d\u8bc1\u4e66\u548c\u6210\u7ee9\u5355\u6258\u7ba1\u7cfb\u7edf\u3002\u5b83\u5229\u7528\u5148\u8fdb\u7684\u52a0\u5bc6\u6280\u672f\uff0c\u786e\u4fdd\u5b66\u751f\u751f\u6210\u7684\u6570\u5b57\u5316PDF\u51ed\u8bc1\u4e0e\u5927\u5b66\u5e95\u5c42\u6570\u636e\u5e93\u5b8c\u5168\u540c\u6b65\uff0c\u5177\u5907\u4e0d\u53ef\u7be1\u6539\u7684\u7edd\u5bf9\u6cd5\u5f8b\u6548\u529b\u3002</p>"},{"location":"#2-myequals","title":"2. \u6bd5\u4e1a\u751f\u5982\u4f55\u901a\u8fc7 MyeQuals \u6388\u6743\u9a8c\u8bc1\uff1f","text":"<ol> <li>\u6fc0\u6d3b\u8d26\u6237\uff1a \u6bd5\u4e1a\u751f\u5728\u4e34\u8fd1\u6bd5\u4e1a\u65f6\uff0c\u4f1a\u6536\u5230\u7531\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b98\u65b9\u7535\u5b50\u90ae\u7bb1\u53d1\u51fa\u7684 MyeQuals \u6ce8\u518c\u9080\u8bf7\u4fe1\u3002</li> <li>\u5728\u7ebf\u6258\u7ba1\uff1a \u767b\u5f55\u540e\uff0c\u6bd5\u4e1a\u751f\u53ef\u4ee5\u5728\u5e73\u53f0\u5185\u76f4\u63a5\u67e5\u770b\u81ea\u5df1\u88ab\u6388\u4e88\u7684\u6570\u5b57\u5b66\u4f4d\u8bc1\u4e66\uff08Digital Testamur\uff09\u53ca\u5b98\u65b9\u5b8c\u6574\u6210\u7ee9\u5355\uff08Digital Transcript\uff09\u3002</li> <li>\u5b89\u5168\u5206\u4eab\uff1a \u6bd5\u4e1a\u751f\u5982\u9700\u5411\u7b2c\u4e09\u65b9\uff08\u5982\u96c7\u4e3b\u3001\u80cc\u8c03\u516c\u53f8\u3001\u5916\u5bfc\uff09\u8bc1\u660e\u5b66\u5386\uff0c\u65e0\u9700\u590d\u5370\u7eb8\u8d28\u4ef6\uff0c\u53ea\u9700\u5728 MyeQuals \u7cfb\u7edf\u4e2d\u751f\u6210\u4e00\u4e2a\u5e26\u6709\u8fc7\u671f\u65f6\u95f4\u548c\u8bbf\u95ee\u5bc6\u7801\u7684\u5b98\u65b9\u5206\u4eab\u94fe\u63a5\uff08Share Link\uff09\u3002</li> </ol>"},{"location":"#3-hr","title":"3. \u4f01\u4e1aHR\u4e0e\u80cc\u8c03\u673a\u6784\u7684\u6838\u9a8c\u6b65\u9aa4","text":"<p>\u4f5c\u4e3a\u5ba1\u67e5\u65b9\uff0cHR\u5728\u6536\u5230\u6c42\u804c\u8005\u63d0\u4f9b\u7684 MyeQuals \u94fe\u63a5\u540e\uff1a * \u8bf7\u52a1\u5fc5\u786e\u8ba4\u8be5\u94fe\u63a5\u7684\u6839\u57df\u540d\u4e3a <code>https://myequals.edu.au</code> \u6216 <code>https://myequals.net</code>\u3002 * \u4e25\u7981\u70b9\u51fb\u4efb\u4f55\u5047\u5192\u57df\u540d\u7684\u7b2c\u4e09\u65b9\u7f51\u9875\u3002 * \u767b\u5f55\u5408\u89c4\u94fe\u63a5\u540e\uff0c\u5728\u7ebf\u67e5\u770b\u7684 PDF \u8bc1\u4e66\u9876\u90e8\u4f1a\u5e26\u6709\u7eff\u8272\u7684\u201c\u5b98\u65b9\u8ba4\u8bc1\uff08Certified\uff09\u201d\u5b89\u5168\u7535\u5b50\u7b7e\u7ae0\u3002\u53ea\u8981\u6b64\u7b7e\u7ae0\u6709\u6548\uff0c\u5373\u767e\u5206\u4e4b\u767e\u8bc1\u660e\u8be5\u6c42\u804c\u8005\u7684\u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u5386\u771f\u5b9e\u5408\u89c4\u3002</p>"},{"location":"#cscse","title":"\u56db\u3001 \u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u670d\u4e2d\u5fc3\uff08CSCSE\uff09\u8ba4\u8bc1\u4e0e\u8de8\u56fd\u6838\u9a8c","text":"<p>\u5bf9\u4e8e\u9009\u62e9\u56de\u56fd\u53d1\u5c55\u7684\u67e5\u5c14\u65af\u7279\u5927\u5b66\u4e2d\u56fd\u7559\u5b66\u751f\u800c\u8a00\uff0c\u4ec5\u6709\u5b66\u6821\u7684\u7269\u7406\u8bc1\u4e66\u548c\u6570\u5b57\u8bc1\u4e66\u662f\u4e0d\u591f\u7684\uff0c\u5fc5\u987b\u901a\u8fc7\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u7684\u56fd\uff08\u5883\uff09\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u3002</p>"},{"location":"#1_1","title":"1. \u7559\u670d\u8ba4\u8bc1\u7684\u6838\u5fc3\u6548\u529b","text":"<p>\u6559\u80b2\u90e8\u7559\u670d\u4e2d\u5fc3\u51fa\u5177\u7684\u300a\u56fd\uff08\u5883\uff09\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u4e66\u300b\u662f\u4e2d\u56fd\u5883\u5185\u552f\u4e00\u7531\u5b98\u65b9\u884c\u653f\u673a\u5173\u80cc\u4e66\u7684\u6d77\u5916\u5b66\u5386\u8bc1\u660e\u3002\u65e0\u8bba\u662f\u62a5\u8003\u56fd\u5bb6\u516c\u52a1\u5458\u3001\u8fdb\u5165\u56fd\u6709\u4f01\u4e8b\u4e1a\u5355\u4f4d\u3001\u7533\u8bf7\u79d1\u7814\u57fa\u91d1\uff0c\u8fd8\u662f\u5728\u5317\u4e0a\u5e7f\u6df1\u7b49\u4e00\u7ebf\u57ce\u5e02\u529e\u7406\u6d77\u5f52\u4eba\u624d\u843d\u6237\u53ca\u7533\u9886\u653f\u5e9c\u8865\u8d34\uff0c\u8be5\u8bc1\u4e66\u5747\u4e3a\u4e00\u7968\u5426\u51b3\u5236\u7684\u5fc5\u5907\u6750\u6599\u3002</p>"},{"location":"#2_1","title":"2. \u67e5\u5c14\u65af\u7279\u5927\u5b66\u5b66\u5386\u5728\u56fd\u5185\u7684\u6838\u9a8c\u8def\u5f84","text":"<p>\u5bf9\u4e8e\u56fd\u5185\u7684\u7528\u4eba\u5355\u4f4d\uff0c\u6838\u9a8c\u4e00\u540d\u67e5\u5c14\u65af\u7279\u5927\u5b66\u6d77\u5f52\u5458\u5de5\u5b66\u5386\u7684\u6700\u5feb\u6377\u3001\u6700\u5408\u89c4\u624b\u6bb5\uff0c\u5c31\u662f\u6838\u5bf9\u5176\u6b21\u7559\u670d\u8ba4\u8bc1\uff1a</p> <ul> <li>\u6838\u9a8c\u4e3b\u9875\uff1a \u767b\u5f55\u4e2d\u56fd\u7559\u5b66\u7f51\u5b98\u65b9\u201c\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u653f\u52a1\u670d\u52a1\u5e73\u53f0\u201d\u3002</li> <li>\u5728\u7ebf\u67e5\u9a8c\uff1a \u8fdb\u5165\u201c\u8ba4\u8bc1\u4e66\u67e5\u8be2\u201d\u7a97\u53e3\uff0c\u8f93\u5165\u6c42\u804c\u8005\u63d0\u4f9b\u7684\u300a\u8ba4\u8bc1\u4e66\u300b\u7f16\u53f7\uff08\u683c\u5f0f\u901a\u5e38\u4e3a\uff1a\u6559\u7559\u670d\u8ba4[\u5e74\u4efd]xxxx\u53f7\uff09\u4ee5\u53ca\u6c42\u804c\u8005\u7684\u59d3\u540d\u3002</li> <li>\u7ed3\u679c\u6bd4\u5bf9\uff1a \u7cfb\u7edf\u4f1a\u76f4\u63a5\u5410\u51fa\u5b98\u65b9\u6570\u636e\u5e93\u4e2d\u7684\u8ba4\u8bc1\u7ed3\u679c\u3002\u5982\u679c\u67e5\u8be2\u6210\u529f\uff0c\u4e14\u663e\u793a\u7684\u5b66\u6821\u540d\u79f0\u4e3a\u201c\u67e5\u5c14\u65af\u7279\u5927\u5b66\uff08Charles Sturt University\uff09\u201d\uff0c\u5219\u4ee3\u8868\u8be5\u5b66\u5386\u5df2\u901a\u8fc7\u4e2d\u56fd\u653f\u5e9c\u7684\u5b98\u65b9\u8de8\u5883\u6838\u9a8c\uff0c\u771f\u4f2a\u6027\u65e0\u9700\u518d\u7591\u3002</li> </ul>"},{"location":"#_2","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u98ce\u9669\u63d0\u793a","text":"<p>\u4f9d\u6cd5\u4f9d\u89c4\u8fdb\u884c\u5b66\u5386\u6210\u679c\u7684\u6838\u9a8c\uff0c\u4e0d\u4ec5\u662f\u4fdd\u969c\u4f01\u4e1a\u7528\u4eba\u5b89\u5168\u3001\u7ef4\u62a4\u804c\u573a\u516c\u5e73\u7684\u6838\u5fc3\u91cd\u4e2d\u4e4b\u91cd\uff0c\u66f4\u662f\u7559\u5b66\u751f\u4fdd\u62a4\u81ea\u8eab\u5927\u5b97\u6559\u80b2\u6295\u8d44\u7684\u5fc5\u8981\u624b\u6bb5\u3002</p> <p>\u4e25\u6b63\u5408\u89c4\u58f0\u660e\uff1a \u67e5\u5c14\u65af\u7279\u5927\u5b66\u6838\u53d1\u7684\u5b66\u4f4d\u8bc1\u4e66\u7531\u6fb3\u5927\u5229\u4e9a\u8054\u90a6\u653f\u5e9c\u53ca\u5927\u5b66\u8463\u4e8b\u4f1a\u4f9d\u6cd5\u7edf\u4e00\u76d1\u5236\u4e0e\u9881\u53d1\u3002\u4efb\u4f55\u79c1\u81ea\u5236\u9020\u3001\u53d8\u9020\u3001\u4e70\u5356\u6216\u4f7f\u7528\u5047\u5192\u6d77\u5916\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u7684\u884c\u4e3a\uff0c\u5747\u89e6\u72af\u56fd\u9645\u6559\u80b2\u8054\u5408\u76d1\u7ba1\u6761\u4f8b\u3002\u5728\u4e2d\u56fd\u5883\u5185\uff0c\u6b64\u884c\u4e3a\u540c\u6837\u89e6\u72af\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5211\u6cd5\u300b\u76f8\u5173\u6761\u6b3e\uff0c\u5c5e\u4e8e\u4f2a\u9020\u56fd\u5bb6\u673a\u5173/\u4f01\u4e8b\u4e1a\u5355\u4f4d\u6587\u51ed\u7ae0\u5236\u7684\u4e25\u91cd\u8fdd\u6cd5\u884c\u4e3a\u3002</p> <p>\u65e0\u8bba\u662f\u4e8c\u624b\u4ea4\u6613\u5e02\u573a\u3001\u975e\u6b63\u89c4\u4e2d\u4ecb\u515c\u552e\u7684\u201c1:1\u7cbe\u4eff\u5927\u7eff\u672c\u6837\u5f0f\u6587\u51ed\u201d\uff0c\u8fd8\u662f\u58f0\u79f0\u80fd\u7ed5\u8fc7\u5b98\u7f51\u6570\u636e\u5e93\u7684\u201c\u5185\u90e8\u6539\u5206\u6bd5\u4e1a\u8bc1\u201d\uff0c\u5728\u5f53\u4eca\u4ea4\u7ba1\u5185\u7f51\u3001MyeQuals \u6570\u5b57\u7cfb\u7edf\u4ee5\u53ca\u7559\u670d\u4e2d\u5fc3\u5f3a\u5927\u7684\u5b9e\u65f6\u8054\u7f51\u6bd4\u5bf9\u9762\u524d\u90fd\u5c06\u65e0\u6240\u9041\u5f62\u3002\u5404\u91d1\u878d\u673a\u6784\u3001\u6d89\u5916\u4f01\u4e8b\u4e1a\u5355\u4f4d\u5728\u5ba1\u67e5\u8d44\u8d28\u65f6\uff0c\u5207\u52ff\u62b1\u6709\u4fa5\u5e78\u5fc3\u7406\uff0c\u8bf7\u52a1\u5fc5\u9075\u5faa\u672c\u6587\u63d0\u4f9b\u7684\u5b98\u65b9\u3001\u6b63\u89c4\u6838\u9a8c\u6e20\u9053\u8fdb\u884c\u5408\u89c4\u64cd\u4f5c\u3002</p>"}]}